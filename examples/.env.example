# Copy this file to ".env" and fill in your credentials, then load it into your
# shell before running an example (see README.md).
#
# From your FastPix Dashboard (https://dashboard.fastpix.com):
#   Access Token -> FASTPIX_USERNAME
#   Secret Key   -> FASTPIX_PASSWORD
FASTPIX_USERNAME=
FASTPIX_PASSWORD=

# From Dashboard > Webhooks (needed to verify webhook signatures).
FASTPIX_WEBHOOK_SECRET=

# Optional: a media that has finished processing (status "Ready"), used by the
# playback, ai-features and cloud-playout examples.
FASTPIX_READY_MEDIA_ID=
